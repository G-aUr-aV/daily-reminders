<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp"
    android:background="@drawable/reminder_widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_header" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center_vertical" android:textSize="15sp"
            android:textStyle="bold" android:textColor="@color/widget_ink" android:maxLines="2" />
        <ImageButton android:id="@+id/widget_add" android:layout_width="48dp" android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_reminder_add"
            android:tint="@color/widget_ink" android:contentDescription="@string/widget_add_reminder" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_rows" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" />
    <TextView android:id="@+id/widget_footer" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="48dp" android:gravity="center_vertical" android:textSize="14sp"
        android:textColor="@color/widget_ink" />
</LinearLayout>
